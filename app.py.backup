import secrets

from datetime import datetime, timedelta

from flask import (

    Flask,

    request,

    jsonify,

    jsonify,

    render_template,  # Changed from render_template_string

    redirect,

    url_for,

    send_file,

)

from report_utils import (
    get_date_range_from_params,
    compute_monthly_breakdown,
