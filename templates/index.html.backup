{% extends "base.html" %}

{% block content %}
<style>
    body {
        font-family: sans-serif;
        margin: 20px;
    }

    h1 {
        margin-bottom: 0.2rem;
    }

    .meta {
        color: #555;
        margin-bottom: 1rem;
    }

    table {
        border-collapse: collapse;
        width: 100%;
    }

    th,
    td {
        border: 1px solid #ccc;
        padding: 4px 8px;
        font-size: 0.9rem;
    }

    th {
        background: #f0f0f0;
        cursor: pointer;
    }

    tr:nth-child(even) {
        background: #fafafa;
    }

    .error {
        color: #b00;
        margin-bottom: 1rem;
    }

    .nav {
        margin-bottom: 1rem;
    }

    .nav a {
        margin-right: 1rem;
    }

    .summary {
        margin-bottom: 1rem;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
        background: #f9f9f9;
    }

    .summary h2 {
        margin: 0 0 0.5rem 0;
        font-size: 1rem;
    }

    .summary ul {
        margin: 0;
        padding-left: 16px;
    }

    .printer-tag {
        display: inline-block;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.85rem;
    }

    .filter-form {
        margin-bottom: 0.5rem;
    }

    .filter-form select,
    .filter-form button,
    .filter-form input[type="date"] {
        padding: 2px 6px;
        font-size: 0.9rem;
        margin-right: 8px;
    }

    .filter-form label {
        margin-right: 12px;
    }

    .charts-container {
        display: flex;
        gap: 20px;
        margin: 20px 0;
        flex-wrap: wrap;
    }

    .chart-box {
        flex: 1;
        min-width: 400px;
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 15px;
        background: #fafafa;
    }

    .chart-box h3 {
        margin: 0 0 10px 0;
        font-size: 1rem;
    }

    .chart-box canvas {
        max-width: 100%;
        height: 250px;
    }

    .actions {
        margin-bottom: 0.5rem;
    }

    .actions button,
    .actions a {
        padding: 3px 8px;
        margin-right: 6px;
        font-size: 0.9rem;
    }

        {
        % if hidden_columns %
    }

        {
        % for key in hidden_columns %
    }

    .col- {
            {
            key
        }
    }

        {
        display: none;
    }

        {
        % endfor %
    }

        {
        % endif %
    }
</style>
<script>
    // Simple client-side table sorter
    let sortState = {};

    function sortTable(colIndex, isNumeric) {
        const table = document.getElementById("history-table");
        if (!table) return;
        const tbody = table.tBodies[0];
        const rows = Array.from(tbody.rows);

        const key = colIndex;
        const currentDir = sortState[key] || "asc";
        const newDir = currentDir === "asc" ? "desc" : "asc";
        sortState[key] = newDir;

        rows.sort(function (a, b) {
            const aText = a.cells[colIndex].innerText.trim();
            const bText = b.cells[colIndex].innerText.trim();

            let aVal = aText;
            let bVal = bText;

            if (isNumeric) {
                aVal = parseFloat(aText) || 0;
                bVal = parseFloat(bText) || 0;
            }

            if (aVal < bVal) return newDir === "asc" ? -1 : 1;
            if (aVal > bVal) return newDir === "asc" ? 1 : -1;
            return 0;
        });

        rows.forEach(row => tbody.appendChild(row));
    }

    function toggleSelectAll(source) {
        const checkboxes = document.querySelectorAll('input[name="delete_rows"]');
        checkboxes.forEach(cb => cb.checked = source.checked);
    }

    function confirmDelete() {
        const checked = document.querySelectorAll('input[name="delete_rows"]:checked');
        if (checked.length === 0) {
            alert("No rows selected for deletion.");
            return false;
        }
        return confirm("Delete selected rows? This cannot be undone.");
    }

    function drawBarChart(canvasId, labels, values, title, yLabel) {
        const canvas = document.getElementById(canvasId);
        if (!canvas) return;
        const ctx = canvas.getContext("2d");
        const width = canvas.width;
        const height = canvas.height;
        const padding = 40;
        const chartWidth = width - 2 * padding;
        const chartHeight = height - 2 * padding;
        const maxValue = Math.max(...values, 1);
        const barWidth = chartWidth / labels.length * 0.8;
        const barSpacing = chartWidth / labels.length * 0.2;

        // Clear canvas
        ctx.clearRect(0, 0, width, height);

        // Draw title
        ctx.fillStyle = "#333";
        ctx.font = "bold 14px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText(title, width / 2, 20);

        // Draw axes
        ctx.strokeStyle = "#666";
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(padding, padding);
        ctx.lineTo(padding, height - padding);
        ctx.lineTo(width - padding, height - padding);
        ctx.stroke();

        // Draw bars
        labels.forEach((label, i) => {
            const barHeight = (values[i] / maxValue) * chartHeight;
            const x = padding + i * (barWidth + barSpacing) + barSpacing / 2;
            const y = height - padding - barHeight;

            // Bar
            ctx.fillStyle = i % 2 === 0 ? "#4a90e2" : "#50c878";
            ctx.fillRect(x, y, barWidth, barHeight);

            // Value label on bar
            if (barHeight > 15) {
                ctx.fillStyle = "#fff";
                ctx.font = "11px sans-serif";
                ctx.textAlign = "center";
                ctx.fillText(values[i].toFixed(1), x + barWidth / 2, y + barHeight / 2 + 4);
            }

            // X-axis label
            ctx.fillStyle = "#333";
            ctx.font = "10px sans-serif";
            ctx.textAlign = "center";
            const displayLabel = label.length > 10 ? label.substring(0, 8) + ".." : label;
            ctx.save();
            ctx.translate(x + barWidth / 2, height - padding + 15);
            ctx.rotate(-Math.PI / 4);
            ctx.fillText(displayLabel, 0, 0);
            ctx.restore();
        });

        // Y-axis scale
        ctx.fillStyle = "#666";
        ctx.font = "10px sans-serif";
        ctx.textAlign = "right";
        for (let i = 0; i <= 5; i++) {
            const value = (maxValue / 5) * i;
            const y = height - padding - (i / 5) * chartHeight;
            ctx.fillText(value.toFixed(1), padding - 5, y + 4);
        }

        // Y-axis label
        ctx.save();
        ctx.translate(15, height / 2);
        ctx.rotate(-Math.PI / 2);
        ctx.textAlign = "center";
        ctx.fillText(yLabel, 0, 0);
        ctx.restore();
    }

    // Draw charts when page loads
    window.addEventListener("load", function () {
        const costData = {{ chart_cost_per_day| tojson
    }};
    const hoursData = {{ chart_hours_per_printer| tojson }};

    if (costData.labels.length > 0) {
        drawBarChart("costPerDayChart", costData.labels, costData.values, "Cost per Day", "Cost ($)");
    }

    if (hoursData.labels.length > 0) {
        drawBarChart("hoursPerPrinterChart", hoursData.labels, hoursData.values, "Hours per Printer", "Hours");
    }
        });
</script>
</head>

<body>
    <div class="nav">
        <a href="{{ url_for('index') }}">History</a>
        <a href="{{ url_for('reports_page') }}">Reports</a>
        <a href="{{ url_for('settings_page') }}">Settings</a>
        <a href="{{ url_for('download_csv') }}">Download CSV</a>
    </div>

    <!-- Printer Overview Section -->
    {% if printer_summaries %}
    <div class="printer-overview" style="margin-bottom: 2rem;">
        <h2>Printer Overview</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 15px;">
            {% for printer_name, summary in printer_summaries.items() %}
            <div class="printer-card"
                style="border: 1px solid #ddd; border-radius: 4px; padding: 12px; background: #fafafa;">
                <h3 style="margin: 0 0 8px 0; font-size: 1rem;">
                    <span class="printer-tag"
                        style="background-color: {{ printer_colors.get(printer_name, '#eee') }}; padding: 4px 8px; border-radius: 3px; font-weight: bold;">
                        {{ printer_name }}
                    </span>
                </h3>
                <div style="font-size: 0.9rem;">
                    <div style="margin-bottom: 4px;">
                        <strong>Status:</strong>
                        <span
                            style="{% if summary.status == 'printing' %}color: #28a745;{% elif summary.status == 'paused' %}color: #ffc107;{% elif summary.status == 'failed' or summary.status == 'canceled' %}color: #dc3545;{% else %}color: #6c757d;{% endif %} font-weight: bold;">
                            {{ summary.status|upper }}
                        </span>
                    </div>
                    <div style="margin-bottom: 4px;">
                        <strong>Last Job:</strong> {{ summary.last_job_name[:30] }}{% if summary.last_job_name|length >
                        30 %}...{% endif %}
                    </div>
                    <div style="margin-bottom: 4px;">
                        <strong>Today:</strong> {{ "%.1f"|format(summary.today_hours) }}h / ${{
                        "%.2f"|format(summary.today_cost) }}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <!-- Now Printing Section -->
    {% if active_jobs %}
    <div class="now-printing"
        style="margin-bottom: 2rem; padding: 15px; border: 2px solid #4a90e2; border-radius: 4px; background: #f0f7ff;">
        <h2 style="margin-top: 0; color: #4a90e2;">🖨️ Now Printing</h2>
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #e0f0ff;">
                    <th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Printer</th>
                    <th style="border: 1px solid #ccc; padding: 6px; text-align: left;">File</th>
                    <th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Status</th>
                    <th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Elapsed</th>
                    <th style="border: 1px solid #ccc; padding: 6px; text-align: right;">Cost So Far</th>
                    <th style="border: 1px solid #ccc; padding: 6px; text-align: right;">Est. Final</th>
                </tr>
            </thead>
            <tbody>
                {% for job in active_jobs %}
                <tr
                    style="{% if job.status == 'paused' %}background: #fff3cd;{% else %}background: #d4edda;{% endif %}">
                    <td style="border: 1px solid #ccc; padding: 6px;">
                        <span class="printer-tag"
                            style="background-color: {{ printer_colors.get(job.printer_name, '#eee') }}">
                            {{ job.printer_name }}
                        </span>
                    </td>
                    <td style="border: 1px solid #ccc; padding: 6px;">{{ job.filename }}</td>
                    <td style="border: 1px solid #ccc; padding: 6px;">
                        <strong>{{ job.status|upper }}</strong>
                    </td>
                    <td style="border: 1px solid #ccc; padding: 6px;">
                        {% set hours = (job.elapsed_seconds // 3600)|int %}
                        {% set mins = ((job.elapsed_seconds % 3600) // 60)|int %}
                        {% set secs = (job.elapsed_seconds % 60)|int %}
                        {{ "%d:%02d:%02d"|format(hours, mins, secs) }}
                    </td>
                    <td style="border: 1px solid #ccc; padding: 6px; text-align: right;">
                        ${{ "%.2f"|format(job.current_time_cost) }}
                    </td>
                    <td style="border: 1px solid #ccc; padding: 6px; text-align: right;">
                        {% if job.estimated_total_cost %}
                        ${{ "%.2f"|format(job.estimated_total_cost) }}
                        {% else %}
                        —
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="now-printing"
        style="margin-bottom: 1rem; padding: 10px; border: 1px solid #ddd; border-radius: 4px; background: #f9f9f9;">
        <h2 style="margin: 0; font-size: 1rem; color: #666;">🖨️ Now Printing</h2>
        <p style="margin: 5px 0 0 0; color: #888;">No active prints</p>
    </div>
    {% endif %}

    <div class="summary">
        <h2>Summary ({{ selected_printer if selected_printer != 'All' else 'All Printers' }})</h2>
        <p>Time range: {{ range_label }}</p>
        <ul>
            <li>Total prints: {{ summary.total_prints }}</li>
            <li>Total hours: {{ "%.2f"|format(summary.total_hours) }}</li>
            <li>Total filament (m): {{ "%.2f"|format(summary.total_meters) }}</li>
            <li>Total cost: ${{ "%.2f"|format(summary.total_cost) }}</li>
        </ul>
    </div>

    <form method="get" class="filter-form">
        <label>
            Printer:
            <select name="printer">
                <option value="All" {% if selected_printer=='All' %}selected{% endif %}>All</option>
                {% for p in printers %}
                <option value="{{ p }}" {% if selected_printer==p %}selected{% endif %}>{{ p }}</option>
                {% endfor %}
            </select>
        </label>

        <label>
            Start date:
            <input type="date" name="start_date" value="{{ start_date }}">
        </label>

        <label>
            End date:
            <input type="date" name="end_date" value="{{ end_date }}">
        </label>

        <label>
            Quick range:
            <select name="quick_range">
                <option value="">(none)</option>
                <option value="last7" {% if quick_range=='last7' %}selected{% endif %}>Last 7 days</option>
                <option value="last30" {% if quick_range=='last30' %}selected{% endif %}>Last 30 days</option>
                <option value="this_month" {% if quick_range=='this_month' %}selected{% endif %}>This month</option>
                <option value="last_month" {% if quick_range=='last_month' %}selected{% endif %}>Last month</option>
            </select>
        </label>

        <button type="submit">Apply</button>
    </form>
    {% if summary.per_printer %}
    <div>By printer:</div>
    <ul>
        {% for p, data in summary.per_printer.items() %}
        <li>{{ p }} – prints: {{ data.count }}, hours: {{ "%.2f"|format(data.hours) }}, cost: ${{
            "%.2f"|format(data.cost) }}{% if summary.days_span > 0 %} (avg ${{ "%.2f"|format(data.cost /
            summary.days_span) }}/day){% endif %}</li>
        {% endfor %}
    </ul>
    {% endif %}
    </div>

    <div class="meta">
        CSV: {{ csv_file }}<br>
        Rows (after filter): {{ rows|length }}
    </div>

    {% if chart_cost_per_day.labels|length > 0 or chart_hours_per_printer.labels|length > 0 %}
    <div class="charts-container">
        {% if chart_cost_per_day.labels|length > 0 %}
        <div class="chart-box">
            <h3>Cost per Day</h3>
            <canvas id="costPerDayChart" width="600" height="300"></canvas>
        </div>
        {% endif %}

        {% if chart_hours_per_printer.labels|length > 0 %}
        <div class="chart-box">
            <h3>Hours per Printer</h3>
            <canvas id="hoursPerPrinterChart" width="600" height="300"></canvas>
        </div>
        {% endif %}
    </div>
    {% endif %}

    {% if error %}
    <div class="error">{{ error }}</div>
    {% endif %}

    <form method="post" onsubmit="return confirmDelete()">
        <input type="hidden" name="action" value="delete">
        <div class="actions">
            <button type="submit">Delete Selected</button>
        </div>

        <table id="history-table">
            <thead>
                <tr>
                    <th><input type="checkbox" onclick="toggleSelectAll(this)"></th>
                    {% for h in headers %}
                    <th class="col-{{ h }}"
                        onclick="sortTable({{ loop.index0 + 1 }}, {{ 'true' if h in ['duration_seconds','duration_hours','filament_mm','filament_meters','total_cost','time_cost','material_cost'] else 'false' }})">
                        {{ friendly_headers.get(h, h) }}
                    </th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                <tr>
                    <td><input type="checkbox" name="delete_rows" value="{{ row.row_index }}"></td>
                    {% for h in headers %}
                    <td class="col-{{ h }}">
                        {% if h == 'printer' %}
                        <span class="printer-tag" style="background-color: {{ printer_colors.get(row[h], '#eee') }}">
                            {{ row[h] }}
                        </span>
                        {% elif h == 'total_cost' or h == 'time_cost' or h == 'material_cost' %}
                        ${{ "%.2f"|format(row[h]|float) }}
                        {% elif h == 'duration_hours' or h == 'filament_meters' %}
                        {{ "%.2f"|format(row[h]|float) }}
                        {% else %}
                        {{ row[h] }}
                        {% endif %}
                    </td>
                    {% endfor %}
                    {% extends "base.html" %}
                    {% block content %}
                    <div style="margin-bottom: 4px;">
                        <strong>Last Job:</strong> {{ summary.last_job_name[:30] }}{% if summary.last_job_name|length >
                        30 %}...{% endif %}
                    </div>
                    <div style="margin-bottom: 4px;">
                        <strong>Today:</strong> {{ "%.1f"|format(summary.today_hours) }}h / ${{
                        "%.2f"|format(summary.today_cost) }}
                    </div>
                    </div>
                    </div>
                    {% endfor %}
                    </div>
                    </div>
                    {% endif %}

                    <!-- Now Printing Section -->
                    {% if active_jobs %}
                    <div class="now-printing"
                        style="margin-bottom: 2rem; padding: 15px; border: 2px solid #4a90e2; border-radius: 4px; background: #f0f7ff;">
                        <h2 style="margin-top: 0; color: #4a90e2;">🖨️ Now Printing</h2>
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background: #e0f0ff;">
                                    <th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Printer</th>
                                    <th style="border: 1px solid #ccc; padding: 6px; text-align: left;">File</th>
                                    <th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Status</th>
                                    <th style="border: 1px solid #ccc; padding: 6px; text-align: left;">Elapsed</th>
                                    <th style="border: 1px solid #ccc; padding: 6px; text-align: right;">Cost So Far
                                    </th>
                                    <th style="border: 1px solid #ccc; padding: 6px; text-align: right;">Est. Final</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for job in active_jobs %}
                                <tr
                                    style="{% if job.status == 'paused' %}background: #fff3cd;{% else %}background: #d4edda;{% endif %}">
                                    <td style="border: 1px solid #ccc; padding: 6px;">
                                        <span class="printer-tag"
                                            style="background-color: {{ printer_colors.get(job.printer_name, '#eee') }}">
                                            {{ job.printer_name }}
                                        </span>
                                    </td>
                                    <td style="border: 1px solid #ccc; padding: 6px;">{{ job.filename }}</td>
                                    <td style="border: 1px solid #ccc; padding: 6px;">
                                        <strong>{{ job.status|upper }}</strong>
                                    </td>
                                    <td style="border: 1px solid #ccc; padding: 6px;">
                                        {% set hours = (job.elapsed_seconds // 3600)|int %}
                                        {% set mins = ((job.elapsed_seconds % 3600) // 60)|int %}
                                        {% set secs = (job.elapsed_seconds % 60)|int %}
                                        {{ "%d:%02d:%02d"|format(hours, mins, secs) }}
                                    </td>
                                    <td style="border: 1px solid #ccc; padding: 6px; text-align: right;">
                                        ${{ "%.2f"|format(job.current_time_cost) }}
                                    </td>
                                    <td style="border: 1px solid #ccc; padding: 6px; text-align: right;">
                                        {% if job.estimated_total_cost %}
                                        ${{ "%.2f"|format(job.estimated_total_cost) }}
                                        {% else %}
                                        —
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <div class="now-printing"
                        style="margin-bottom: 1rem; padding: 10px; border: 1px solid #ddd; border-radius: 4px; background: #f9f9f9;">
                        <h2 style="margin: 0; font-size: 1rem; color: #666;">🖨️ Now Printing</h2>
                        <p style="margin: 5px 0 0 0; color: #888;">No active prints</p>
                    </div>
                    {% endif %}

                    <div class="summary">
                        <h2>Summary ({{ selected_printer if selected_printer != 'All' else 'All Printers' }})</h2>
                        <p>Time range: {{ range_label }}</p>
                        <ul>
                            <li>Total prints: {{ summary.total_prints }}</li>
                            <li>Total hours: {{ "%.2f"|format(summary.total_hours) }}</li>
                            <li>Total filament (m): {{ "%.2f"|format(summary.total_meters) }}</li>
                            <li>Total cost: ${{ "%.2f"|format(summary.total_cost) }}</li>
                        </ul>
                    </div>

                    <form method="get" class="filter-form">
                        <label>
                            Printer:
                            <select name="printer">
                                <option value="All" {% if selected_printer=='All' %}selected{% endif %}>All</option>
                                {% for p in printers %}
                                <option value="{{ p }}" {% if selected_printer==p %}selected{% endif %}>{{ p }}</option>
                                {% endfor %}
                            </select>
                        </label>

                        <label>
                            Start date:
                            <input type="date" name="start_date" value="{{ start_date }}">
                        </label>

                        <label>
                            End date:
                            <input type="date" name="end_date" value="{{ end_date }}">
                        </label>

                        <label>
                            Quick range:
                            <select name="quick_range">
                                <option value="">(none)</option>
                                <option value="last7" {% if quick_range=='last7' %}selected{% endif %}>Last 7 days
                                </option>
                                <option value="last30" {% if quick_range=='last30' %}selected{% endif %}>Last 30 days
                                </option>
                                <option value="this_month" {% if quick_range=='this_month' %}selected{% endif %}>This
                                    month</option>
                                <option value="last_month" {% if quick_range=='last_month' %}selected{% endif %}>Last
                                    month</option>
                            </select>
                        </label>

                        <button type="submit">Apply</button>
                    </form>
                    {% if summary.per_printer %}
                    <div>By printer:</div>
                    <ul>
                        {% for p, data in summary.per_printer.items() %}
                        <li>{{ p }} – prints: {{ data.count }}, hours: {{ "%.2f"|format(data.hours) }}, cost: ${{
                            "%.2f"|format(data.cost) }}{% if summary.days_span > 0 %} (avg ${{ "%.2f"|format(data.cost /
                            summary.days_span) }}/day){% endif %}</li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                    </div>

                    <div class="meta">
                        CSV: {{ csv_file }}<br>
                        Rows (after filter): {{ rows|length }}
                    </div>

                    {% if chart_cost_per_day.labels|length > 0 or chart_hours_per_printer.labels|length > 0 %}
                    <div class="charts-container">
                        {% if chart_cost_per_day.labels|length > 0 %}
                        <div class="chart-box">
                            <h3>Cost per Day</h3>
                            <canvas id="costPerDayChart" width="600" height="300"></canvas>
                        </div>
                        {% endif %}

                        {% if chart_hours_per_printer.labels|length > 0 %}
                        <div class="chart-box">
                            <h3>Hours per Printer</h3>
                            <canvas id="hoursPerPrinterChart" width="600" height="300"></canvas>
                        </div>
                        {% endif %}
                    </div>
                    {% endif %}

                    {% if error %}
                    <div class="error">{{ error }}</div>
                    {% endif %}

                    <form method="post" onsubmit="return confirmDelete()">
                        <input type="hidden" name="action" value="delete">
                        <div class="actions">
                            <button type="submit">Delete Selected</button>
                        </div>

                        <table id="history-table">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" onclick="toggleSelectAll(this)"></th>
                                    {% for h in headers %}
                                    <th class="col-{{ h }}"
                                        onclick="sortTable({{ loop.index0 + 1 }}, {{ 'true' if h in ['duration_seconds','duration_hours','filament_mm','filament_meters','total_cost','time_cost','material_cost'] else 'false' }})">
                                        {{ friendly_headers.get(h, h) }}
                                    </th>
                                    {% endfor %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in rows %}
                                <tr>
                                    <td><input type="checkbox" name="delete_rows" value="{{ row.row_index }}"></td>
                                    {% for h in headers %}
                                    <td class="col-{{ h }}">
                                        {% if h == 'printer' %}
                                        <span class="printer-tag"
                                            style="background-color: {{ printer_colors.get(row[h], '#eee') }}">
                                            {{ row[h] }}
                                        </span>
                                        {% elif h == 'total_cost' or h == 'time_cost' or h == 'material_cost' %}
                                        ${{ "%.2f"|format(row[h]|float) }}
                                        {% elif h == 'duration_hours' or h == 'filament_meters' %}
                                        {{ "%.2f"|format(row[h]|float) }}
                                        {% else %}
                                        {{ row[h] }}
                                        {% endif %}
                                        <div style="margin-bottom: 4px;">
                                            <strong>Today:</strong> {{ "%.1f"|format(summary.today_hours) }}h / ${{
                                            "%.2f"|format(summary.today_cost) }}
                                        </div>
                                        </div>
                                        </div>
                                        {% endfor %}
                                        </div>
                                        </div>
                                        {% endif %}

                                        <!-- Now Printing Section -->
                                        {% if active_jobs %}
                                        <div class="now-printing"
                                            style="margin-bottom: 2rem; padding: 15px; border: 2px solid #4a90e2; border-radius: 4px; background: #f0f7ff;">
                                            <h2 style="margin-top: 0; color: #4a90e2;">🖨️ Now Printing</h2>
                                            <table style="width: 100%; border-collapse: collapse;">
                                                <thead>
                                                    <tr style="background: #e0f0ff;">
                                                        <th
                                                            style="border: 1px solid #ccc; padding: 6px; text-align: left;">
                                                            Printer</th>
                                                        <th
                                                            style="border: 1px solid #ccc; padding: 6px; text-align: left;">
                                                            File</th>
                                                        <th
                                                            style="border: 1px solid #ccc; padding: 6px; text-align: left;">
                                                            Status</th>
                                                        <th
                                                            style="border: 1px solid #ccc; padding: 6px; text-align: left;">
                                                            Elapsed</th>
                                                        <th
                                                            style="border: 1px solid #ccc; padding: 6px; text-align: right;">
                                                            Cost So Far
                                                        </th>
                                                        <th
                                                            style="border: 1px solid #ccc; padding: 6px; text-align: right;">
                                                            Est. Final</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for job in active_jobs %}
                                                    <tr
                                                        style="{% if job.status == 'paused' %}background: #fff3cd;{% else %}background: #d4edda;{% endif %}">
                                                        <td style="border: 1px solid #ccc; padding: 6px;">
                                                            <span class="printer-tag"
                                                                style="background-color: {{ printer_colors.get(job.printer_name, '#eee') }}">
                                                                {{ job.printer_name }}
                                                            </span>
                                                        </td>
                                                        <td style="border: 1px solid #ccc; padding: 6px;">{{
                                                            job.filename }}</td>
                                                        <td style="border: 1px solid #ccc; padding: 6px;">
                                                            <strong>{{ job.status|upper }}</strong>
                                                        </td>
                                                        <td style="border: 1px solid #ccc; padding: 6px;">
                                                            {% set hours = (job.elapsed_seconds // 3600)|int %}
                                                            {% set mins = ((job.elapsed_seconds % 3600) // 60)|int %}
                                                            {% set secs = (job.elapsed_seconds % 60)|int %}
                                                            {{ "%d:%02d:%02d"|format(hours, mins, secs) }}
                                                        </td>
                                                        <td
                                                            style="border: 1px solid #ccc; padding: 6px; text-align: right;">
                                                            ${{ "%.2f"|format(job.current_time_cost) }}
                                                        </td>
                                                        <td
                                                            style="border: 1px solid #ccc; padding: 6px; text-align: right;">
                                                            {% if job.estimated_total_cost %}
                                                            ${{ "%.2f"|format(job.estimated_total_cost) }}
                                                            {% else %}
                                                            —
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                        {% else %}
                                        <div class="now-printing"
                                            style="margin-bottom: 1rem; padding: 10px; border: 1px solid #ddd; border-radius: 4px; background: #f9f9f9;">
                                            <h2 style="margin: 0; font-size: 1rem; color: #666;">🖨️ Now Printing</h2>
                                            <p style="margin: 5px 0 0 0; color: #888;">No active prints</p>
                                        </div>
                                        {% endif %}

                                        <div class="summary">
                                            <h2>Summary ({{ selected_printer if selected_printer != 'All' else 'All
                                                Printers' }})</h2>
                                            <p>Time range: {{ range_label }}</p>
                                            <ul>
                                                <li>Total prints: {{ summary.total_prints }}</li>
                                                <li>Total hours: {{ "%.2f"|format(summary.total_hours) }}</li>
                                                <li>Total filament (m): {{ "%.2f"|format(summary.total_meters) }}</li>
                                                <li>Total cost: ${{ "%.2f"|format(summary.total_cost) }}</li>
                                            </ul>
                                        </div>

                                        <form method="get" class="filter-form">
                                            <label>
                                                Printer:
                                                <select name="printer">
                                                    <option value="All" {% if selected_printer=='All' %}selected{% endif
                                                        %}>All</option>
                                                    {% for p in printers %}
                                                    <option value="{{ p }}" {% if selected_printer==p %}selected{% endif
                                                        %}>{{ p }}</option>
                                                    {% endfor %}
                                                </select>
                                            </label>

                                            <label>
                                                Start date:
                                                <input type="date" name="start_date" value="{{ start_date }}">
                                            </label>

                                            <label>
                                                End date:
                                                <input type="date" name="end_date" value="{{ end_date }}">
                                            </label>

                                            <label>
                                                Quick range:
                                                <select name="quick_range">
                                                    <option value="">(none)</option>
                                                    <option value="last7" {% if quick_range=='last7' %}selected{% endif
                                                        %}>Last 7 days
                                                    </option>
                                                    <option value="last30" {% if quick_range=='last30' %}selected{%
                                                        endif %}>Last 30 days
                                                    </option>
                                                    <option value="this_month" {% if quick_range=='this_month'
                                                        %}selected{% endif %}>This
                                                        month</option>
                                                    <option value="last_month" {% if quick_range=='last_month'
                                                        %}selected{% endif %}>Last
                                                        month</option>
                                                </select>
                                            </label>

                                            <button type="submit">Apply</button>
                                        </form>
                                        {% if summary.per_printer %}
                                        <div>By printer:</div>
                                        <ul>
                                            {% for p, data in summary.per_printer.items() %}
                                            <li>{{ p }} – prints: {{ data.count }}, hours: {{ "%.2f"|format(data.hours)
                                                }}, cost: ${{
                                                "%.2f"|format(data.cost) }}{% if summary.days_span > 0 %} (avg ${{
                                                "%.2f"|format(data.cost /
                                                summary.days_span) }}/day){% endif %}</li>
                                            {% endfor %}
                                        </ul>
                                        {% endif %}
                                        </div>

                                        <div class="meta">
                                            CSV: {{ csv_file }}<br>
                                            Rows (after filter): {{ rows|length }}
                                        </div>

                                        {% if chart_cost_per_day.labels|length > 0 or
                                        chart_hours_per_printer.labels|length > 0 %}
                                        <div class="charts-container">
                                            {% if chart_cost_per_day.labels|length > 0 %}
                                            <div class="chart-box">
                                                <h3>Cost per Day</h3>
                                                <canvas id="costPerDayChart" width="600" height="300"></canvas>
                                            </div>
                                            {% endif %}

                                            {% if chart_hours_per_printer.labels|length > 0 %}
                                            <div class="chart-box">
                                                <h3>Hours per Printer</h3>
                                                <canvas id="hoursPerPrinterChart" width="600" height="300"></canvas>
                                            </div>
                                            {% endif %}
                                        </div>
                                        {% endif %}

                                        {% if error %}
                                        <div class="error">{{ error }}</div>
                                        {% endif %}

                                        <form method="post" onsubmit="return confirmDelete()">
                                            <input type="hidden" name="action" value="delete">
                                            <div class="actions">
                                                <button type="submit">Delete Selected</button>
                                            </div>

                                            <table id="history-table">
                                                <thead>
                                                    <tr>
                                                        <th><input type="checkbox" onclick="toggleSelectAll(this)"></th>
                                                        {% for h in headers %}
                                                        <th class="col-{{ h }}"
                                                            onclick="sortTable({{ loop.index0 + 1 }}, {{ 'true' if h in ['duration_seconds','duration_hours','filament_mm','filament_meters','total_cost','time_cost','material_cost'] else 'false' }})">
                                                            {{ friendly_headers.get(h, h) }}
                                                        </th>
                                                        {% endfor %}
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for row in rows %}
                                                    <tr>
                                                        <td><input type="checkbox" name="delete_rows"
                                                                value="{{ row.row_index }}"></td>
                                                        {% for h in headers %}
                                                        <td class="col-{{ h }}">
                                                            {% if h == 'printer' %}
                                                            <span class="printer-tag"
                                                                style="background-color: {{ printer_colors.get(row[h], '#eee') }}">
                                                                {{ row[h] }}
                                                            </span>
                                                            {% elif h == 'total_cost' or h == 'time_cost' or h ==
                                                            'material_cost' %}
                                                            ${{ "%.2f"|format(row[h]|float) }}
                                                            {% elif h == 'duration_hours' or h == 'filament_meters' %}
                                                            {{ "%.2f"|format(row[h]|float) }}
                                                            {% else %}
                                                            {{ row[h] }}
                                                            {% endif %}
                                                            Status</th>
                                                        <th
                                                            style="border: 1px solid #ccc; padding: 6px; text-align: left;">
                                                            Elapsed</th>
                                                        <th
                                                            style="border: 1px solid #ccc; padding: 6px; text-align: right;">
                                                            Cost So Far
                                                        </th>
                                                        <th
                                                            style="border: 1px solid #ccc; padding: 6px; text-align: right;">
                                                            Est. Final</th>
                                                    </tr>
                                                    </thead>
                                                <tbody>
                                                    {% for job in active_jobs %}
                                                    <tr
                                                        style="{% if job.status == 'paused' %}background: #fff3cd;{% else %}background: #d4edda;{% endif %}">
                                                        <td style="border: 1px solid #ccc; padding: 6px;">
                                                            <span class="printer-tag"
                                                                style="background-color: {{ printer_colors.get(job.printer_name, '#eee') }}">
                                                                {{ job.printer_name }}
                                                            </span>
                                                        </td>
                                                        <td style="border: 1px solid #ccc; padding: 6px;">{{
                                                            job.filename }}</td>
                                                        <td style="border: 1px solid #ccc; padding: 6px;">
                                                            <strong>{{ job.status|upper }}</strong>
                                                        </td>
                                                        <td style="border: 1px solid #ccc; padding: 6px;">
                                                            {% set hours = (job.elapsed_seconds // 3600)|int %}
                                                            {% set mins = ((job.elapsed_seconds % 3600) // 60)|int %}
                                                            {% set secs = (job.elapsed_seconds % 60)|int %}
                                                            {{ "%d:%02d:%02d"|format(hours, mins, secs) }}
                                                        </td>
                                                        <td
                                                            style="border: 1px solid #ccc; padding: 6px; text-align: right;">
                                                            ${{ "%.2f"|format(job.current_time_cost) }}
                                                        </td>
                                                        <td
                                                            style="border: 1px solid #ccc; padding: 6px; text-align: right;">
                                                            {% if job.estimated_total_cost %}
                                                            ${{ "%.2f"|format(job.estimated_total_cost) }}
                                                            {% else %}
                                                            —
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                            </div>
                                            {% else %}
                                            <div class="now-printing"
                                                style="margin-bottom: 1rem; padding: 10px; border: 1px solid #ddd; border-radius: 4px; background: #f9f9f9;">
                                                <h2 style="margin: 0; font-size: 1rem; color: #666;">🖨️ Now Printing
                                                </h2>
                                                <p style="margin: 5px 0 0 0; color: #888;">No active prints</p>
                                            </div>
                                            {% endif %}

                                            <div class="summary">
                                                <h2>Summary ({{ selected_printer if selected_printer != 'All' else 'All
                                                    Printers' }})</h2>
                                                <p>Time range: {{ range_label }}</p>
                                                <ul>
                                                    <li>Total prints: {{ summary.total_prints }}</li>
                                                    <li>Total hours: {{ "%.2f"|format(summary.total_hours) }}</li>
                                                    <li>Total filament (m): {{ "%.2f"|format(summary.total_meters) }}
                                                    </li>
                                                    <li>Total cost: ${{ "%.2f"|format(summary.total_cost) }}</li>
                                                </ul>
                                            </div>

                                            <form method="get" class="filter-form">
                                                <label>
                                                    Printer:
                                                    <select name="printer">
                                                        <option value="All" {% if selected_printer=='All' %}selected{%
                                                            endif %}>All</option>
                                                        {% for p in printers %}
                                                        <option value="{{ p }}" {% if selected_printer==p %}selected{%
                                                            endif %}>{{ p }}</option>
                                                        {% endfor %}
                                                    </select>
                                                </label>

                                                <label>
                                                    Start date:
                                                    <input type="date" name="start_date" value="{{ start_date }}">
                                                </label>

                                                <label>
                                                    End date:
                                                    <input type="date" name="end_date" value="{{ end_date }}">
                                                </label>

                                                <label>
                                                    Quick range:
                                                    <select name="quick_range">
                                                        <option value="">(none)</option>
                                                        <option value="last7" {% if quick_range=='last7' %}selected{%
                                                            endif %}>Last 7 days
                                                        </option>
                                                        <option value="last30" {% if quick_range=='last30' %}selected{%
                                                            endif %}>Last 30 days
                                                        </option>
                                                        <option value="this_month" {% if quick_range=='this_month'
                                                            %}selected{% endif %}>This
                                                            month</option>
                                                        <option value="last_month" {% if quick_range=='last_month'
                                                            %}selected{% endif %}>Last
                                                            month</option>
                                                    </select>
                                                </label>

                                                <button type="submit">Apply</button>
                                            </form>
                                            {% if summary.per_printer %}
                                            <div>By printer:</div>
                                            <ul>
                                                {% for p, data in summary.per_printer.items() %}
                                                <li>{{ p }} – prints: {{ data.count }}, hours: {{
                                                    "%.2f"|format(data.hours)
                                                    }}, cost: ${{
                                                    "%.2f"|format(data.cost) }}{% if summary.days_span > 0 %} (avg ${{
                                                    "%.2f"|format(data.cost /
                                                    summary.days_span) }}/day){% endif %}</li>
                                                {% endfor %}
                                            </ul>
                                            {% endif %}
                                            </div>

                                            <div class="meta">
                                                CSV: {{ csv_file }}<br>
                                                Rows (after filter): {{ rows|length }}
                                            </div>

                                            {% if chart_cost_per_day.labels|length > 0 or
                                            chart_hours_per_printer.labels|length > 0 %}
                                            <div class="charts-container">
                                                {% if chart_cost_per_day.labels|length > 0 %}
                                                <div class="chart-box">
                                                    <h3>Cost per Day</h3>
                                                    <canvas id="costPerDayChart" width="600" height="300"></canvas>
                                                </div>
                                                {% endif %}

                                                {% if chart_hours_per_printer.labels|length > 0 %}
                                                <div class="chart-box">
                                                    <h3>Hours per Printer</h3>
                                                    <canvas id="hoursPerPrinterChart" width="600" height="300"></canvas>
                                                </div>
                                                {% endif %}
                                            </div>
                                            {% endif %}

                                            {% if error %}
                                            <div class="error">{{ error }}</div>
                                            {% endif %}

                                            <form method="post" onsubmit="return confirmDelete()">
                                                <input type="hidden" name="action" value="delete">
                                                <div class="actions">
                                                    <button type="submit">Delete Selected</button>
                                                </div>

                                                <table id="history-table">
                                                    <thead>
                                                        <tr>
                                                            <th><input type="checkbox" onclick="toggleSelectAll(this)">
                                                            </th>
                                                            {% for h in headers %}
                                                            <th class="col-{{ h }}"
                                                                onclick="sortTable({{ loop.index0 + 1 }}, {{ 'true' if h in ['duration_seconds','duration_hours','filament_mm','filament_meters','total_cost','time_cost','material_cost'] else 'false' }})">
                                                                {{ friendly_headers.get(h, h) }}
                                                            </th>
                                                            {% endfor %}
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        {% for row in rows %}
                                                        <tr>
                                                            <td><input type="checkbox" name="delete_rows"
                                                                    value="{{ row.row_index }}"></td>
                                                            {% for h in headers %}
                                                            <td class="col-{{ h }}">
                                                                {% if h == 'printer' %}
                                                                <span class="printer-tag"
                                                                    style="background-color: {{ printer_colors.get(row[h], '#eee') }}">
                                                                    {{ row[h] }}
                                                                </span>
                                                                {% elif h == 'total_cost' or h == 'time_cost' or h ==
                                                                'material_cost' %}
                                                                ${{ "%.2f"|format(row[h]|float) }}
                                                                {% elif h == 'duration_hours' or h == 'filament_meters'
                                                                %}
                                                                {{ "%.2f"|format(row[h]|float) }}
                                                                {% else %}
                                                                {{ row[h] }}
                                                                {% endif %}
                                                            </td>
                                                            {% endfor %}
                                                        </tr>
                                                        {% endfor %}
                                                    </tbody>
                                                </table>
                                            </form>
                                            {% endblock %}