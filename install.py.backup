def settings_menu():
    while True:
        println("=== Settings Menu ===")
        println("  1) Show current settings")
        println("  2) Change master URL (and update clients)")
        println("  3) Change API key (and update clients)")
        println("  4) Change local printer directory")
        println("  5) Change remote script path")
        println("  6) Change Docker service name")
        println("  7) List registered clients")
        println("  8) Reset installer state")
        println("  9) Back")
        choice = input("Select option [1-9] (or 'b' to go back): ").strip()

        if choice == "1":
            show_current_settings()
        elif choice == "2":
            change_master_url_settings()
        elif choice == "3":
            change_api_key_settings()
        elif choice == "4":
            change_printer_dir_settings()
        elif choice == "5":
            change_remote_script_path_settings()
        elif choice == "6":
            change_service_name_settings()
        elif choice == "7":
            list_registered_clients()
        elif choice == "8":
            reset_install_state()
        elif choice == "9" or choice.lower() == "b":
            return
        else:
            println("Invalid choice. Try again.")


# -----------------------------
# Main menu
# -----------------------------

def main():
    println("=== Print Cost Dashboard Installer ===")
    println("Note: For most questions, you can just press Enter to accept the default shown.\n")
    while True:
        println("\nMain Menu")
        println("  1) Install MASTER on THIS machine (dashboard)")
        println("  2) Install CLIENT (local or remote)")
        println("  3) Uninstall (master or client)")
        println("  4) Settings")
        println("  5) Exit")
        choice = input("Select option [1-5] (or 'b' to exit): ").strip()

        if choice == "1":
            master_install_menu()
        elif choice == "2":
            client_install_menu()
        elif choice == "3":
            uninstall_main_menu()
        elif choice == "4":
            settings_menu()
        elif choice == "5" or choice.lower() == "b":
            println("Goodbye.")
            break
        else:
            println("Invalid choice. Try again.")


if __name__ == "__main__":
    main()
