# -----------------------------
# Client Registry (Phase 3 - Propagation)
# -----------------------------

def get_client_registry():
    """
    Get the list of registered clients from install_state.json.
    Returns a list of client dictionaries.
    """
    clients = load_state("clients", [])
    if not isinstance(clients, list):
        return []
    return clients


def save_client_registry(clients):
    """
    Save the client registry to install_state.json.
    """
    save_state("clients", clients)


def register_client(client_type, printer_name=None, cfg_dir=None, script_path=None, host=None, config_dir=None):
    """
    Register a new client installation.
    
    Args:
        client_type: "local" or "remote"
        printer_name: Printer name label (for both types)
        cfg_dir: Local config directory (for local clients)
        script_path: Path to send_print_cost.sh
        host: Remote host (user@ip) for remote clients
        config_dir: Remote config directory (for remote clients)
    """
    clients = get_client_registry()
    
    # Check if this client already exists (by script_path for local, by host+script_path for remote)
    for i, client in enumerate(clients):
        if client_type == "local" and client.get("type") == "local":
            if client.get("script_path") == script_path:
                # Update existing local client
                clients[i] = {
                    "type": "local",
                    "printer_name": printer_name,
                    "cfg_dir": cfg_dir,
                    "script_path": script_path,
                }
                save_client_registry(clients)
                return
        elif client_type == "remote" and client.get("type") == "remote":
            if client.get("host") == host and client.get("script_path") == script_path:
                # Update existing remote client
                clients[i] = {
                    "type": "remote",
                    "printer_name": printer_name,
                    "host": host,
                    "config_dir": config_dir,
                    "script_path": script_path,
                }
                save_client_registry(clients)
                return
    
    # Add new client
    if client_type == "local":
        clients.append({
            "type": "local",
            "printer_name": printer_name,
            "cfg_dir": cfg_dir,
            "script_path": script_path,
        })
    elif client_type == "remote":
        clients.append({
            "type": "remote",
            "printer_name": printer_name,
            "host": host,
            "config_dir": config_dir,
            "script_path": script_path,
        })
    
    save_client_registry(clients)


def unregister_client(client_type, script_path=None, host=None):
    """
    Remove a client from the registry.
    """
    clients = get_client_registry()
    filtered = []
    
    for client in clients:
        if client_type == "local" and client.get("type") == "local":
            if client.get("script_path") != script_path:
                filtered.append(client)
        elif client_type == "remote" and client.get("type") == "remote":
            if client.get("host") != host or client.get("script_path") != script_path:
                filtered.append(client)
        else:
            # Keep clients of different type
            filtered.append(client)
    
    save_client_registry(filtered)


def list_registered_clients():
    """
    Display all registered clients.
    """
    clients = get_client_registry()
    if not clients:
        println("No registered clients found.")
        return
    
    println(f"\nRegistered Clients ({len(clients)}):")
    for i, client in enumerate(clients, 1):
        if client.get("type") == "local":
            println(f"  {i}. LOCAL: {client.get('printer_name', 'Unknown')}")
            println(f"     Config: {client.get('cfg_dir', 'N/A')}")
            println(f"     Script: {client.get('script_path', 'N/A')}")
        elif client.get("type") == "remote":
            println(f"  {i}. REMOTE: {client.get('printer_name', 'Unknown')}")
            println(f"     Host: {client.get('host', 'N/A')}")
            println(f"     Config: {client.get('config_dir', 'N/A')}")
            println(f"     Script: {client.get('script_path', 'N/A')}")
    println()


def propagate_to_all_clients(master_url=None, api_key=None, printer_name_updates=None):
    """
    Propagate settings changes to all registered clients.
    
    Args:
        master_url: New master URL (None to skip)
        api_key: New API key (None to skip)
        printer_name_updates: Dict mapping script_path to new printer_name (None to skip)
    """
    clients = get_client_registry()
    if not clients:
        println("No registered clients to update.")
        return
    
    if master_url is None and api_key is None and printer_name_updates is None:
        println("No changes to propagate.")
        return
    
    println(f"\nPropagating changes to {len(clients)} registered client(s)...")
    
    updated_count = 0
    failed_count = 0
    
    for client in clients:
        client_type = client.get("type")
        script_path = client.get("script_path")
        
        if client_type == "local":
            # Update local client
            if not script_path or not os.path.exists(script_path):
                println(f"  ⚠ Skipping local client (script not found: {script_path})")
                failed_count += 1
                continue
            
            # Update script if URL or API key changed
            if master_url is not None or api_key is not None:
                current_url = master_url if master_url else get_master_url_default()
                current_key = api_key if api_key else get_api_key_default()
                try:
                    write_local_client_script(script_path, current_url, current_key)
                    println(f"  ✓ Updated local client script: {script_path}")
                    updated_count += 1
                except Exception as e:
                    println(f"  ✗ Failed to update local client: {e}")
                    failed_count += 1
            
            # Update print_cost.cfg if printer name changed
            if printer_name_updates and script_path in printer_name_updates:
                new_name = printer_name_updates[script_path]
                cfg_dir = client.get("cfg_dir")
                if cfg_dir:
                    cfg_path = os.path.join(cfg_dir, "print_cost.cfg")
                    try:
                        cfg_content = make_print_cost_cfg(new_name, script_path)
                        with open(cfg_path, "w") as f:
                            f.write(cfg_content)
                        println(f"  ✓ Updated print_cost.cfg for {new_name}")
                        # Update registry with new name
                        client["printer_name"] = new_name
                        updated_count += 1
                    except Exception as e:
                        println(f"  ✗ Failed to update print_cost.cfg: {e}")
                        failed_count += 1
        
        elif client_type == "remote":
            # Update remote client
            host = client.get("host")
            if not host or not script_path:
                println(f"  ⚠ Skipping remote client (missing host or script path)")
                failed_count += 1
                continue
            
            # Test SSH connection
            code, out, err = ssh_run(host, "echo 'Connection test'")
            if code != 0:
                println(f"  ⚠ Skipping remote client {host} (SSH connection failed)")
                failed_count += 1
                continue
            
            # Update script if URL or API key changed
            if master_url is not None or api_key is not None:
                current_url = master_url if master_url else get_master_url_default()
                current_key = api_key if api_key else get_api_key_default()
                content = make_client_script_contents(current_url, current_key)
                try:
                    ok = remote_write_file(host, script_path, content, mode=0o755)
                    if ok:
                        println(f"  ✓ Updated remote client script: {host}:{script_path}")
                        updated_count += 1
                    else:
                        println(f"  ✗ Failed to update remote client script: {host}:{script_path}")
                        failed_count += 1
                except Exception as e:
                    println(f"  ✗ Failed to update remote client: {e}")
                    failed_count += 1
            
            # Update print_cost.cfg if printer name changed
            if printer_name_updates and script_path in printer_name_updates:
                new_name = printer_name_updates[script_path]
                config_dir = client.get("config_dir")
                if config_dir:
                    cfg_path = os.path.join(config_dir, "print_cost.cfg")
                    cfg_content = make_print_cost_cfg(new_name, script_path)
                    try:
                        ok = remote_write_file(host, cfg_path, cfg_content, mode=0o644)
                        if ok:
                            println(f"  ✓ Updated remote print_cost.cfg for {new_name} on {host}")
                            client["printer_name"] = new_name
                            updated_count += 1
                        else:
                            println(f"  ✗ Failed to update remote print_cost.cfg on {host}")
                            failed_count += 1
                    except Exception as e:
                        println(f"  ✗ Failed to update remote print_cost.cfg: {e}")
                        failed_count += 1
    
    # Save updated registry
    save_client_registry(clients)
    
    println(f"\nPropagation complete: {updated_count} updated, {failed_count} failed")


