def show_current_settings():
    println("=== Current Installer Settings ===")
    master_url = get_master_url_default()
    api_key = get_api_key_default()
    printer_dir = load_state("printer_dir", "")
    script_path = load_state("script_path", "")
    remote_script_path = load_state("remote_script_path", "")
    master_host = load_state("master_host", "")
    master_port = load_state("master_port", DEFAULT_PORT)
    service_name = load_state("master_service_name", DEFAULT_SERVICE_NAME)

    println(f"Master URL      : {master_url or '<not set>'}")
    println(f"Master host     : {master_host or '<not set>'}")
    println(f"Master port     : {master_port}")
    println(f"Service name    : {service_name}")
    println(f"API key         : {api_key or '<not set>'}")
    println(f"Local printer dir: {printer_dir or '<not set>'}")
    println(f"Local script path: {script_path or '<not set>'}")
    println(f"Remote script path: {remote_script_path or '<not set>'}")
    println()


def update_local_client_script(master_url=None, api_key=None):
    script_path = load_state("script_path", "")
    if not script_path:
        println("No stored local client script path in installer state.")
        return False
    if not os.path.exists(script_path):
        println(f"Local client script not found at {script_path}.")
        return False

    if master_url is None:
        master_url = get_master_url_default()
    if api_key is None:
        api_key = get_api_key_default()

    println(f"Updating local client script at {script_path} ...")
    write_local_client_script(script_path, master_url, api_key)
    println("Local client script updated.")
    return True


def update_remote_client_script(master_url=None, api_key=None):
    remote_script_path = load_state("remote_script_path", "")
    if not remote_script_path:
        println("No stored remote script path in installer state.")
        return False

    remote = input("Remote host (user@ip) for existing remote client (or 'b' to cancel): ").strip()
    if remote.lower() == "b" or not remote:
        println("Cancelled remote update.")
        return False

    if master_url is None:
        master_url = get_master_url_default()
    if api_key is None:
        api_key = get_api_key_default()

    content = make_client_script_contents(master_url, api_key)
    println(f"Updating remote client script at {remote}:{remote_script_path} ...")
    ok = remote_write_file(remote, remote_script_path, content, mode=0o755)
    if ok:
        println("Remote client script updated.")
        return True
    else:
        println("Failed to update remote client script.")
        return False


def change_master_url_settings():
    println("=== Change Master URL ===")
    current = get_master_url_default()
    println(f"Current master URL: {current or '<not set>'}")
    new_url = input(f"New master URL [{current}] (or 'b' to cancel): ").strip()
    if new_url.lower() == "b":
        println("Cancelled.")
        return
    if not new_url:
        new_url = current

    if not new_url:
        println("Master URL cannot be empty.")
        return

    if not (new_url.startswith("http://") or new_url.startswith("https://")):
        new_url = "http://" + new_url

    # Best-effort parse of host:port
    host_part = new_url
    if "://" in new_url:
        host_part = new_url.split("://", 1)[1]
    host_only = host_part.split("/", 1)[0]
    host = host_only
    port = DEFAULT_PORT
    if ":" in host_only:
        h, p = host_only.split(":", 1)
        host = h
        try:
            port = int(p)
        except ValueError:
            port = DEFAULT_PORT

    save_state("master_url", new_url)
    save_state("master_host", host)
    save_state("master_port", port)
    println(f"Updated master URL to {new_url}")
    println(f"master_host={host}, master_port={port}")

    # Phase 3: Propagate to all registered clients
    clients = get_client_registry()
    if clients:
        println(f"\nFound {len(clients)} registered client(s).")
        ans_propagate = input("Update all registered clients with new master URL? [Y/n]: ").strip().lower()
        if ans_propagate not in ("n", "no"):
            propagate_to_all_clients(master_url=new_url)
        else:
            println("Skipping client updates.")
    else:
        # Fallback to old behavior if no registry
        ans_local = input("Update local client script to use this new URL? [y/N]: ").strip().lower()
        if ans_local in ("y", "yes"):
            update_local_client_script(master_url=new_url)

        ans_remote = input("Update remote client script to use this new URL? [y/N]: ").strip().lower()
        if ans_remote in ("y", "yes"):
            update_remote_client_script(master_url=new_url)


def change_api_key_settings():
    println("=== Change API Key ===")
    current = get_api_key_default()
    println(f"Current API key: {current or '<not set>'}")
    new_key = input("Enter new API key (leave blank to generate a new random one, or 'b' to cancel): ").strip()
    if new_key.lower() == "b":
        println("Cancelled.")
        return
    if not new_key:
        new_key = secrets.token_hex(16)
        println(f"Generated new API key: {new_key}")

    ensure_api_key(existing_key=new_key)
    println("Updated API key in data/secret.json and installer state.")

    # Phase 3: Propagate to all registered clients
    clients = get_client_registry()
    if clients:
        println(f"\nFound {len(clients)} registered client(s).")
        ans_propagate = input("Update all registered clients with new API key? [Y/n]: ").strip().lower()
        if ans_propagate not in ("n", "no"):
            propagate_to_all_clients(api_key=new_key)
        else:
            println("Skipping client updates.")
    else:
        # Fallback to old behavior if no registry
        ans_local = input("Update local client script to use this new API key? [y/N]: ").strip().lower()
        if ans_local in ("y", "yes"):
            update_local_client_script(api_key=new_key)

        ans_remote = input("Update remote client script to use this new API key? [y/N]: ").strip().lower()
        if ans_remote in ("y", "yes"):
            update_remote_client_script(api_key=new_key)


