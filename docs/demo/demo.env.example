# Foundation and Basic Demo data only. Do not expose publicly before the remaining phases.
KCD_RUNTIME_MODE=demo
KCD_STORAGE_BACKEND=sql
KCD_REPORTS_BACKEND=sql
KCD_DEMO_DATA_ROOT=/app/demo-data
KCD_DEMO_SEED_NAME=basic-v1
KCD_DEMO_IDLE_TTL_HOURS=24
KCD_DEMO_ABSOLUTE_TTL_HOURS=72
KCD_DEMO_TOUCH_INTERVAL_SECONDS=300
# Cross-process request leases. Heartbeat must be shorter than lease lifetime.
KCD_DEMO_REQUEST_LEASE_SECONDS=120
KCD_DEMO_REQUEST_LEASE_HEARTBEAT_SECONDS=30
KCD_DEMO_MAX_REQUEST_BYTES=1048576
KCD_DEMO_MAX_TEXT_LENGTH=256
KCD_DEMO_MAX_NOTES_LENGTH=4096
KCD_DEMO_MAX_LIST_LENGTH=1000
KCD_DEMO_RATE_GENERAL_LIMIT=300
KCD_DEMO_RATE_GENERAL_WINDOW_SECONDS=300
KCD_DEMO_RATE_MUTATION_LIMIT=60
KCD_DEMO_RATE_MUTATION_WINDOW_SECONDS=300
KCD_DEMO_RATE_LIFECYCLE_LIMIT=5
KCD_DEMO_RATE_LIFECYCLE_WINDOW_SECONDS=600
KCD_DEMO_RATE_INVALID_SESSION_LIMIT=60
KCD_DEMO_RATE_INVALID_SESSION_WINDOW_SECONDS=300
KCD_DEMO_MAX_PRINTERS=10
KCD_DEMO_MAX_FILAMENT_PROFILES=50
KCD_DEMO_MAX_HOURLY_PROFILES=25
KCD_DEMO_MAX_PROJECTS=100
KCD_DEMO_MAX_HISTORY_RECORDS=1000
KCD_DEMO_MAX_WORKSPACE_BYTES=26214400
KCD_DEMO_MAX_WORKSPACES=64
KCD_DEMO_MAX_EXPORT_BYTES=10485760
# Leave proxy trust disabled until the staging proxy is explicitly configured.
KCD_DEMO_TRUST_PROXY=0
# Enable only behind verified HTTPS; this also enables HSTS and strict origin evidence.
KCD_DEMO_EXPECT_HTTPS=0
# Keep enabled behind HTTPS. Set to 0 only in local HTTP tests.
KCD_DEMO_COOKIE_SECURE=1
